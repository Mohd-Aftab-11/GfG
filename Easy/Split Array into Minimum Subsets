class Solution {
    int minSubsets(int arr[]) {
        java.util.Arrays.sort(arr);
        
        int subsets = 1;
        int n = arr.length;
        
        if (n <= 1) return n;
        
        for (int i = 1; i < n; i++) {
            if (arr[i] != arr[i-1] + 1) {
                subsets++;
            }
        }
        return subsets;
    }
}
