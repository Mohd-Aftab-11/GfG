class Solution {
    public int countMinOperations(int arr[]) {
        int n = arr.length;
        int operations = 0;
        
        while (true) {
            int zeroCount = 0;
            boolean allEven = true;
            
            for (int i = 0; i < n; i++) {
                if (arr[i] == 0) {
                    zeroCount++;
                }
                if (arr[i] % 2 != 0) {
                    allEven = false;
                }
            }
            if (zeroCount == n) {
                break;
            }
            if (allEven) {
                for (int i = 0; i < n; i++) {
                    arr[i] /= 2;
                }
                operations++;
            } else {
                for (int i = 0; i < n; i++) {
                    if (arr[i] % 2 != 0) {
                        arr[i]--;
                        operations++;
                    }
                }
            }
        }
        return operations;
    }
}
