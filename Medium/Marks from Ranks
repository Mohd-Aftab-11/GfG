import java.util.*;

class Solution {
    public ArrayList<Integer> getMarks(int[] l, int[] r, int[] rank) {
        int n = l.length;
        int q = rank.length;

        long[] prefix = new long[n];
        prefix[0] = r[0] - l[0] + 1;
        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + (r[i] - l[i] + 1);
        }

        ArrayList<Integer> result = new ArrayList<>();

        for (int rnk : rank) {
            int low = 0, high = n - 1;
            while (low < high) {
                int mid = low + (high - low) / 2;
                if (prefix[mid] >= rnk) {
                    high = mid;
                } else {
                    low = mid + 1;
                }
            }

            int idx = low;
            long prevCount = (idx == 0) ? 0 : prefix[idx - 1];
            int offset = (int)(rnk - prevCount - 1);
            int mark = l[idx] + offset;
            result.add(mark);
        }
        return result;
    }
}
