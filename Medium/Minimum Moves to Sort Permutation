class Solution {
    public int minMoves(int[] arr) {
        int n = arr.length;
        int[] pos = new int[n + 1];
        for (int i = 0; i < n; i++) {
            pos[arr[i]] = i;
        }

        int maxLen = 1;
        int currentLen = 1;
        for (int val = 1; val < n; val++) {
            if (pos[val] < pos[val + 1]) {
                currentLen++;
                maxLen = Math.max(maxLen, currentLen);
            } else {
                currentLen = 1;
            }
        }
        return n - maxLen;
    }
}
