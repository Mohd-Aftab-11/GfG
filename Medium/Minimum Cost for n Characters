import java.util.*;

class Solution {
    public int minCost(int n, int i, int d, int c) {
        int MAX = 2 * n;
        int[] dp = new int[MAX + 1];
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        boolean changed = true;
        while (changed) {
            changed = false;
            for (int x = 0; x <= MAX; x++) {
                if (dp[x] == Integer.MAX_VALUE) continue;

                if (x + 1 <= MAX && dp[x + 1] > dp[x] + i) {
                    dp[x + 1] = dp[x] + i;
                    changed = true;
                }

                if (x > 0 && dp[x - 1] > dp[x] + d) {
                    dp[x - 1] = dp[x] + d;
                    changed = true;
                }

                if (x * 2 <= MAX && dp[x * 2] > dp[x] + c) {
                    dp[x * 2] = dp[x] + c;
                    changed = true;
                }
            }
        }
        return dp[n];
    }
}
