import java.util.Arrays;

class Solution {
    public int countTriplets(int[] arr, int l, int r) {
        int n = arr.length;
        Arrays.sort(arr);

        int countR = countTripletsLessThanOrEqual(arr, r);
        int countL = countTripletsLessThanOrEqual(arr, l - 1);

        return countR - countL;
    }

    private int countTripletsLessThanOrEqual(int[] arr, int target) {
        int n = arr.length;
        int count = 0;

        for (int i = 0; i < n - 2; i++) {
            int left = i + 1;
            int right = n - 1;

            while (left < right) {
                int sum = arr[i] + arr[left] + arr[right];

                if (sum <= target) {
                    count += (right - left);
                    left++;
                } else {
                    right--;
                }
            }
        }
        return count;
    }
}
