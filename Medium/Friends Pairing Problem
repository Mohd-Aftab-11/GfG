class Solution {
    public int countFriendsPairings(int n) {
        if (n <= 2) {
            return n;
        }
        int MOD = 1000000007;
        
        long[] dp = new long[n + 1];
        dp[0] = 1;
        dp[1] = 1;
        
        for (int i = 2; i <= n; i++) {
            dp[i] = (dp[i - 1] + (i - 1) * dp[i - 2]) % MOD;
        }
        return (int) dp[n];
    }
}
