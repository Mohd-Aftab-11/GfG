class Solution {
    public int palindromicStrings(int n, int k) {
        final int MOD = 1_000_000_007;

        long[] fact = new long[k + 1];
        long[] invFact = new long[k + 1];
        fact[0] = 1;
        for (int i = 1; i <= k; i++) {
            fact[i] = fact[i - 1] * i % MOD;
        }

        invFact[k] = modPow(fact[k], MOD - 2, MOD);
        for (int i = k - 1; i >= 0; i--) {
            invFact[i] = invFact[i + 1] * (i + 1) % MOD;
        }

        java.util.function.BiFunction<Integer, Integer, Long> perm = (a, b) -> {
            if (b > a || b < 0) return 0L;
            return fact[a] * invFact[a - b] % MOD;
        };

        long ans = 0;

        for (int len = 1; len <= n; len++) {
            int m = len / 2;
            if (len % 2 == 0) {
                ans = (ans + perm.apply(k, m)) % MOD;
            } else {
                if (k - 1 >= m) {
                    ans = (ans + k * perm.apply(k - 1, m)) % MOD;
                }
            }
        }
        return (int) ans;
    }

    private long modPow(long a, long e, long mod) {
        long res = 1;
        while (e > 0) {
            if ((e & 1) == 1) res = res * a % mod;
            a = a * a % mod;
            e >>= 1;
        }
        return res;
    }
}
