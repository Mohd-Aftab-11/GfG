class Solution {
    public int minDeletions(int[] arr) {
        int n = arr.length;
        
        int[] tails = new int[n];
        int lisLength = 0;
        
        for (int num : arr) {
            int left = 0, right = lisLength;
            while (left < right) {
                int mid = left + (right - left) / 2;
                if (tails[mid] < num) {
                    left = mid + 1;
                } else {
                    right = mid;
                }
            }
            if (left == lisLength) {
                tails[lisLength++] = num;
            } else {
                tails[left] = num;
            }
        }
        return n - lisLength;
    }
}
