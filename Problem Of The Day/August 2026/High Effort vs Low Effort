class Solution {
    public int maxTask(int[] h, int[] l) {
        int n = h.length;
        
        int[][] dp = new int[n][2];
        
        dp[0][0] = 0;
        dp[0][1] = Math.max(l[0], h[0]);
        
        for (int i = 1; i < n; i++) {
            dp[i][0] = Math.max(dp[i-1][0], dp[i-1][1]);
            dp[i][1] = Math.max(dp[i-1][0], dp[i-1][1]) + l[i];
            dp[i][1] = Math.max(dp[i][1], dp[i-1][0] + h[i]);
        }
        return Math.max(dp[n-1][0], dp[n-1][1]);
    }
}
