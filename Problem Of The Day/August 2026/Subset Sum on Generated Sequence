class Solution {
    public boolean isPossible(int[] arr, int s, int x) {
        if (x == 0) return true;
        
        java.util.ArrayList<Long> seq = new java.util.ArrayList<>();
        seq.add((long) s);
        long total = s;
        
        for (int i = 0; i < arr.length; i++) {
            long nextNum = total + arr[i];
            if (nextNum > x) {
                break;
            }
            seq.add(nextNum);
            total += nextNum;
        }
        
        long remaining = x;
        for (int i = seq.size() - 1; i >= 0; i--) {
            long num = seq.get(i);
            if (num <= remaining) {
                remaining -= num;
                if (remaining == 0) {
                    return true;
                }
            }
        }
        return remaining == 0;
    }
}
