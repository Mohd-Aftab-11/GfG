class Solution {
    public int count(int n, int m) {
        int[][] dp = new int[n + 1][m + 1];
        
        for (int j = 1; j <= m; j++) {
            dp[1][j] = 1;
        }
        for (int i = 2; i <= n; i++) {
            for (int j = 1; j <= m; j++) {
                int total = 0;
                for (int k = 1; k <= m; k++) {
                    if (k % j == 0 || j % k == 0) {
                        total += dp[i - 1][k];
                    }
                }
                dp[i][j] = total;
            }
        }
        int result = 0;
        for (int j = 1; j <= m; j++) {
            result += dp[n][j];
        }
        return result;
    }
}
