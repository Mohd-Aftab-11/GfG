import java.util.ArrayList;
import java.util.List;


public class Solution {
    public static boolean findPath(Node root, int target, List<Node> path) {
        if (root == null)
            return false;

        path.add(root);

        if (root.data == target)
            return true;

        if (findPath(root.left, target, path))
            return true;

        if (findPath(root.right, target, path))
            return true;

        path.remove(path.size() - 1);
        return false;
    }

    public static int numberOfTurns(Node root, int p, int q) {
        List<Node> pathP = new ArrayList<>();
        List<Node> pathQ = new ArrayList<>();

        findPath(root, p, pathP);
        findPath(root, q, pathQ);

        if (pathP.isEmpty() || pathQ.isEmpty()) {
            return -1;
        }

        int i = 0;
        while (i < pathP.size() && i < pathQ.size() && pathP.get(i) == pathQ.get(i)) {
            i++;
        }
        int lcaIndex = i - 1;

        List<Node> path = new ArrayList<>();

        for (int j = pathP.size() - 1; j >= lcaIndex; j--) {
            path.add(pathP.get(j));
        }

        for (int j = lcaIndex + 1; j < pathQ.size(); j++) {
            path.add(pathQ.get(j));
        }

        if (path.size() <= 1) {
            return -1;
        }

        int turns = 0;
        int prevDir = 0;

        for (int j = 0; j + 1 < path.size(); j++) {
            Node current = path.get(j);
            Node next = path.get(j + 1);

            int currDir;

            if (current.left == next) {
                currDir = 1;
            }
            else if (current.right == next) {
                currDir = 2;
            }
            else if (next.left == current) {
                currDir = 1;
            }
            else if (next.right == current) {
                currDir = 2;
            } else {
                continue;
            }

            if (prevDir != 0 && prevDir != currDir) {
                turns++;
            }
           prevDir = currDir;
        }
       return turns == 0 ? -1 : turns;
    }

    public static void main(String[] args) {
        Node root = new Node(1);
        root.left = new Node(2);
        root.right = new Node(3);
        root.left.left = new Node(4);
        root.left.right = new Node(5);
        root.right.left = new Node(6);
        root.right.right = new Node(7);
        root.left.left.left = new Node(8);
        root.right.left.left = new Node(9);
        root.right.left.right = new Node(10);

        int p = 5;
        int q = 10;

        System.out.println(numberOfTurns(root, p, q)); // Expected: 4
    }
}
