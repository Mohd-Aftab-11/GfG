import java.util.Arrays;

class Solution {
    public int maxArea(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        int[][] height = new int[n][m];

        for (int j = 0; j < m; j++) {
            height[0][j] = mat[0][j];
            for (int i = 1; i < n; i++) {
                if (mat[i][j] == 1) {
                    height[i][j] = height[i-1][j] + 1;
                } else {
                    height[i][j] = 0;
                }
            }
        }
        int maxArea = 0;

        for (int i = 0; i < n; i++) {
            int[] heights = height[i];
            Arrays.sort(heights);

            for (int k = 0; k < m; k++) {
                int h = heights[m - 1 - k];
                int width = k + 1;
                maxArea = Math.max(maxArea, h * width);
            }
        }
        return maxArea;
    }
}
